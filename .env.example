# Local development only. Do not commit an .env with real credentials.
DEBUG=True
DJANGO_SECRET_KEY=change-this-development-key
# On Render, add the Neon PostgreSQL connection string in the dashboard.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# On Render, add your Cloudinary URL to preserve uploaded images.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional comma-separated browser origins; mobile apps do not use CORS.
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=
